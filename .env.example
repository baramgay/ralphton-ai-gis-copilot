DATA_GO_KR_SERVICE_KEY=
# HIRA 병원정보서비스 v2 (없으면 DATA_GO_KR_SERVICE_KEY 재사용)
HIRA_HOSP_SERVICE_KEY=
DATA_SYNC_SECRET=
# Vercel Cron (optional). Vercel injects Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Slack/Discord/webhook URL for failed cron sync (optional)
CRON_ALERT_WEBHOOK=
# Set to 1 to skip population merge during live sync
LIVE_POPULATION_DISABLED=

# 자연어 의도 파서 (DeepSeek). 키만 넣으면 된다 — BASE_URL을 비우면
# https://api.deepseek.com/v1 로 붙는다. 값을 넣을 경우 허용 호스트만 통과한다.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_PRIMARY_MODEL=deepseek-v4-flash
DEEPSEEK_JSON_FALLBACK_MODEL=deepseek-v4-pro

# RAG 원격 임베딩 (optional). 채팅 제공자와 별개다 — DeepSeek에는 임베딩
# 엔드포인트가 없다. 비우면 오프라인 해시 임베딩으로 동작한다.
# Set to 1 (or set EMBED_MODEL) to re-rank parse-path RAG with remote embeddings
RAG_REMOTE_EMBED=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
