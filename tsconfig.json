{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  /*
   * scripts/kimi-review/*는 외부 검증용 일회성 진단 스크립트다. **붉은 것이 정상**이고
   * (결함을 재현하는 검사가 들어 있다) src를 고치면 같이 깨지므로 게이트에 넣지 않는다.
   * vitest도 같은 이유로 include를 tests/**로 좁혀 두었다.
   */
  "exclude": ["node_modules", "scripts/kimi-review"]
}
